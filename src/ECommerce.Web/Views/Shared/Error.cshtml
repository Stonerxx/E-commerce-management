@model ErrorViewModel
@{
    ViewData["Title"] = "操作未完成";
}

<div class="container py-5">
    <div class="mx-auto border rounded bg-white p-4" style="max-width: 640px;">
        <h1 class="h3 mb-3">操作未完成</h1>
        <p class="text-muted mb-3">@Model.Message</p>
        @if (Model.ShowRequestId)
        {
            <p class="small text-muted mb-4">问题编号：<code>@Model.RequestId</code></p>
        }
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary" type="button" onclick="window.location.reload()">重新尝试</button>
            <a class="btn btn-outline-secondary" href="/">返回首页</a>
        </div>
    </div>
</div>
